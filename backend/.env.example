# ===== SaathMein backend environment =====
# Copy to .env and fill in real values. Never commit .env.

# ===== Server =====
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
# Browser origins allowed by CORS (seller/admin web, Expo web), comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ===== Database (MongoDB Atlas — replica set so transactions work) =====
# TODO: Replace with your MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=your_mongodb_atlas_connection_string_here

# ===== Redis (Upstash) — BullMQ, cache, rate limits, socket adapter =====
# TODO: Replace with your Upstash Redis URL (rediss://...). Optional until Day 6.
REDIS_URL=your_redis_url_here

# ===== Buyer / seller app auth (Day 2) =====
# TODO: Replace with long random secrets (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=your_long_random_access_secret_here
JWT_REFRESH_SECRET=your_long_random_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Password hashing cost (12 or more in production)
BCRYPT_ROUNDS=12

# ===== Staff (admin console) auth — separate secrets (Day 2) =====
# TODO: Replace with long random secrets, different from the app secrets above
STAFF_JWT_ACCESS_SECRET=your_staff_access_secret_here
STAFF_JWT_REFRESH_SECRET=your_staff_refresh_secret_here
STAFF_JWT_ACCESS_EXPIRES_IN=15m
STAFF_JWT_REFRESH_EXPIRES_IN=8h
STAFF_IDLE_TIMEOUT=30m

# ===== Staff 2FA secret encryption (Day 2) =====
# TODO: Replace with 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after staff have set up 2FA (their authenticators would stop working).
TWO_FACTOR_ENCRYPTION_KEY=your_64_hex_char_two_factor_key_here

# ===== Owner account — used only by `npm run create-owner` (Day 2) =====
# TODO: Replace with your email and a strong password (12+ chars, upper, lower, digit, symbol).
# Remove OWNER_PASSWORD after the Owner is created.
OWNER_EMAIL=your_owner_email_here
OWNER_PASSWORD=your_strong_owner_password_here
OWNER_NAME=Vishal Chavan

# ===== Firebase Admin — verifies phone OTP logins (Day 2) =====
# TODO: Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the private key on one line with \n for line breaks, inside double quotes.
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"

# ===== Cloudinary — avatars, product images, KYC docs, invoices (Day 3) =====
# TODO: Cloudinary console → Settings → API Keys. Copy the cloud name, API key and secret.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ===== Razorpay — dealer Route linked accounts (Day 5), payments (Day 7) =====
# TODO: Razorpay Dashboard (TEST mode) → Account & Settings → API Keys. Use rzp_test_ keys in development.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# TODO: set when webhooks are added on Day 7 (different from the key secret)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Business category for dealer linked accounts — confirm the values in Razorpay's
# "business category and sub-category" list for your account
RAZORPAY_ROUTE_CATEGORY=ecommerce
RAZORPAY_ROUTE_SUBCATEGORY=ecommerce_marketplace

# ===== Email (Resend) — dealer codes, KYC updates, staff invites (Day 5) =====
# TODO: resend.com → API Keys (starts with re_). Without it, emails are only written to the server log.
RESEND_API_KEY=your_resend_api_key_here
# TODO: a sender on a domain you verified in Resend
EMAIL_FROM=SaathMein <no-reply@your-domain>

# ===== Dealer dashboard URL (links inside emails) =====
SELLER_WEB_URL=http://localhost:3000/seller

# ===== Share links + Android App Links (Day 8) =====
# TODO: your public domain, e.g. https://saathmein.in (share links: <base>/g/<code>)
APP_LINK_BASE_URL=http://localhost:5000
ANDROID_PACKAGE_NAME=com.saathmein.app
# TODO: SHA-256 of the app signing key(s) from Play Console > App integrity (comma separated)
ANDROID_SHA256_CERT_FINGERPRINTS=
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.saathmein.app

# ===== Push notifications (Expo push service; the FCM key is uploaded to Expo) =====
# Optional: only if you turn on enhanced push security on expo.dev
EXPO_ACCESS_TOKEN=
