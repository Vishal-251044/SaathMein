# ===== SaathMein backend environment =====
# Copy to .env and fill in real values. Never commit .env.

# ===== Server =====
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
# Browser origins allowed by CORS (seller/admin web, Expo web), comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ===== Database (MongoDB Atlas — replica set so transactions work) =====
# TODO: Replace with your MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=your_mongodb_atlas_connection_string_here

# ===== Redis (Upstash) — BullMQ, cache, rate limits, socket adapter =====
# TODO: Replace with your Upstash Redis URL (rediss://...). Optional until Day 6.
REDIS_URL=your_redis_url_here
