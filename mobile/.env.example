# ===== SaathMein buyer app (Expo) =====
# Copy to .env. EXPO_PUBLIC_* values are bundled into the app and visible to anyone:
# NEVER put secrets here.

# ===== API =====
# TODO: On a real phone use your computer's LAN IP (e.g. http://192.168.1.20:5000/api),
# not localhost. In production, use your deployed backend URL.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# ===== Live updates (Socket.io) =====
# TODO: same host as the API, without /api (e.g. http://192.168.1.20:5000)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# ===== Share links / Android App Links =====
# TODO: your public domain without https:// (e.g. saathmein.in). Links: https://<host>/g/<code>
EXPO_PUBLIC_APP_LINK_HOST=saathmein.in

# ===== Website (legal pages: terms, privacy, refund policy, grievance officer) =====
# TODO: your public website, e.g. https://saathmein.in
EXPO_PUBLIC_WEB_URL=https://saathmein.in

# Sentry (Day 14). Public DSN (not a secret); leave the placeholder to keep it off.
EXPO_PUBLIC_SENTRY_DSN=your_mobile_sentry_dsn_here

# Google sign-in (PRD F4): the "Web client" OAuth id from Firebase → Authentication →
# Sign-in method → Google (public id, not a secret). Placeholder = Google button hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
